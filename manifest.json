{
  "name": "ApplyLog Job Tracker",
  "description": "Track your job/internship applications and automatically sync them to Google Sheets!",
  "key": "",
  "version": "4.1.4",
  "manifest_version": 3,
  "action": {
    "default_popup": "popup.html",
    "default_icon": "ApplyLogIcon.png"
  },
  "permissions": [
    "identity",
    "storage"
  ],
  "oauth2": {
    "client_id": "292911840518-css6b0s7d0ul3f73o0lbshhcafgk4v54.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://sheets.googleapis.com/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://applylogtracker.com/*"
    ]
  }
}